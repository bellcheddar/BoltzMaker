.DS_Store

# Local staging bundle for manual upload to WordPress -- not tracked in git
wordpress/

# Exported Claude Code session transcripts. `/export` writes them into the repo
# folder, and a transcript carries the whole conversation -- compound codenames,
# share passwords, private run keys. This repo is public. One `git add -A` is all
# it would take, so they are ignored rather than left to discipline.
*-this-session-is-being-continued-*.txt
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9]*.txt

# README backups taken before a rewrite. Working copies, not history --
# git already has that.
README.backup*.md

# Elementor README/report forge output (regenerate with readme_forge.py as needed)
*.polished.md
README.html
README.preview.html
BoltzMaker.html
BoltzMaker.preview.html
findings.html
findings.preview.html
elementor-widget-markdown.css

# Unpacked campaign bundles. Running a bundle inside the repo (easy to do while
# testing the web app) leaves a folder with its own multi-GB .pixi environment.
# One of those was 2.3GB and got as far as being rsync'd to the droplet before
# anyone noticed, so it is excluded here as well as in web/deploy/deploy.sh.
*.command
*.bmz
.pixi/
