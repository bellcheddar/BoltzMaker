#!/usr/bin/env python3
"""Pack a finished campaign into one .bmz results file.

Written into the bundle by {{ site_url }} and run on your machine after the
campaign finishes. Reads what BoltzMaker's `analyze` produced and writes a
single zip to upload back for exploration.

Stdlib only, deliberately: this runs in the pixi environment right after a
long campaign, and a packing step that fails on an import would be the worst
possible moment to discover a missing dependency.

**What is included, and what is not.** The .bmz carries the structured data --
the summary CSVs, one structure per target, and the labelled PLIP interaction
image per target -- and BoltzMaker's own generated reports, which are the
dashboard and the compare-sse page.

The reports were left out at first, on the grounds that the web Analysis step
renders its own views. It renders two of them. The dashboard has fifteen panels:
the campaign summary, the ligand preparation table, the 2D ligand grid, ranked
pIC50 and confidence, the family-by-ligand selectivity heatmap, interaction
counts, pIC50 against binder probability, a residue interaction fingerprint per
family, a binding-site panel per target, and the secondary-structure tables and
charts. Re-implementing those in the browser would duplicate the analysis code
and drift from it; shipping what BoltzMaker itself produced cannot drift. It
costs about 9MB compressed on a 15-target campaign.

The PyMOL .pse sessions are still left behind -- 50.6MB on that same campaign,
and nothing reads them but PyMOL.
"""

from __future__ import annotations

import csv
import hashlib
import json
import platform
import shutil
import sys
import time
import zipfile
from datetime import datetime, timezone
from pathlib import Path

BMZ_VERSION = {{ bmz_version }}

CAMPAIGN_DIR = Path(__file__).resolve().parent
MD_PATH = CAMPAIGN_DIR / "boltz_input.md"
SUMMARY_CSV = CAMPAIGN_DIR / "boltz_summary.csv"
OUT_PATH = CAMPAIGN_DIR / "{{ results_filename }}"

# Stay under the web app's own 200MB upload ceiling with room to spare, rather
# than writing a file that packs happily here and is refused on upload. When the
# cap bites, structures are dropped before images: a missing pose viewer costs
# one panel, whereas a missing summary row costs the target entirely.
MAX_TOTAL_BYTES = 180 * 1024 * 1024

# The earliest timestamp a zip can represent. Anything older is clamped rather
# than raised on: this runs *after* the campaign, so a file with an odd mtime
# must never be the reason hours of finished compute cannot be packed. The
# bundle's own files used to arrive dated 1970 and did exactly that.
ZIP_SAFE_EPOCH = 315532800  # 1980-01-01T00:00:00Z

BLUE, GREEN, AMBER, RED, RESET = (
    "\033[38;2;30;115;190m", "\033[38;2;0;208;132m",
    "\033[38;2;252;185;0m", "\033[38;2;216;27;140m", "\033[0m",
)


def info(msg): print(f"{BLUE}i{RESET} {msg}")
def ok(msg): print(f"{GREEN}v{RESET} {msg}")
def warn(msg): print(f"{AMBER}!{RESET} {msg}")
def fail(msg): print(f"{RED}x{RESET} {msg}", file=sys.stderr)


def sha256_of(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def main() -> int:
    if not SUMMARY_CSV.is_file():
        fail("boltz_summary.csv not found -- `analyze` did not produce a summary.")
        info("Nothing to pack. Re-run this campaign, or run `pixi run analyze boltz_input.md`.")
        return 1

    with SUMMARY_CSV.open(newline="", encoding="utf-8") as fh:
        rows = list(csv.DictReader(fh))
    if not rows:
        fail("boltz_summary.csv has a header but no rows -- no target completed.")
        return 1

    # (arcname, source path) pairs, plus a parallel record of what was left out
    # and why. Nothing is dropped silently: every omission lands in the manifest
    # and is printed, so a half-populated Analysis page is explainable from the
    # file itself rather than a mystery.
    members: list[tuple[str, Path]] = []
    skipped: list[dict] = []

    def add(arcname: str, path: Path, kind: str) -> None:
        if not path.is_file():
            skipped.append({"arcname": arcname, "kind": kind, "reason": "not found on disk"})
            return
        members.append((arcname, path))

    add("boltz_input.md", MD_PATH, "spec")
    # BoltzMaker's own reports, exactly as it wrote them. These are what the web
    # Analysis step shows for everything its own panels do not cover.
    for name in ("boltz_dashboard.html", "boltz_sse_comparison.html"):
        path = CAMPAIGN_DIR / name
        if path.is_file():
            members.append((f"reports/{name}", path))
    add("config.json", CAMPAIGN_DIR / "config.json", "config")
    # The wizard state this campaign was built from, if the bundle carried one.
    # Without it, extending a finished campaign means retyping every protein,
    # ligand and pocket into the form, or hand-editing the spec.
    add("page_state.json", CAMPAIGN_DIR / "page_state.json", "wizard state")
    for name in ("boltz_summary.csv", "boltz_interactions.csv",
                 "boltz_sse_comparison.csv", "boltz_sse_family_status.json"):
        path = CAMPAIGN_DIR / name
        if path.is_file():
            members.append((f"summary/{name}", path))

    # The ligand-pose pairs: two ligands each, a few kilobytes, and the only thing in
    # the payload that compares a prediction with an experiment. Added by name from
    # the index rather than by globbing the folder, so a stale file left by an earlier
    # analyze of a campaign that has since changed is not shipped as current.
    pose_index = CAMPAIGN_DIR / "boltz_pose_pairs" / "index.json"
    if pose_index.is_file():
        members.append(("posepairs/index.json", pose_index))
        try:
            pairs = json.loads(pose_index.read_text()).get("pairs") or []
        except (json.JSONDecodeError, OSError):
            pairs = []
        for pair in pairs:
            stem = str(pair.get("stem") or "")
            for which in ("pred", "ref"):
                add(f"posepairs/{stem}_{which}.cif",
                    CAMPAIGN_DIR / "boltz_pose_pairs" / f"{stem}_{which}.cif",
                    "ligand pose pair")

    # One structure and one interaction image per target, named by target_id
    # rather than by Boltz's own filenames. The web side then addresses a target
    # by its id alone and never has to re-derive `{stem}_model_0.cif`.
    for row in rows:
        target = (row.get("target_id") or "").strip()
        if not target:
            continue
        cif_name = (row.get("cif_file") or "").strip()
        if cif_name:
            add(f"structures/{target}.cif", CAMPAIGN_DIR / "boltz_cif" / cif_name, "structure")
        png_rel = (row.get("plip_png_path") or "").strip()
        if png_rel:
            add(f"plip/{target}.png", CAMPAIGN_DIR / png_rel, "interaction image")

    # Enforce the ceiling before writing anything, dropping structures first.
    total = sum(p.stat().st_size for _, p in members)
    if total > MAX_TOTAL_BYTES:
        warn(f"payload is {total / 1024 / 1024:.0f}MB, over the {MAX_TOTAL_BYTES // 1024 // 1024}MB limit")
        kept: list[tuple[str, Path]] = []
        running = 0
        # Largest structures go first: dropping two 20MB complexes beats dropping
        # twenty small ones, and the smaller targets stay explorable.
        # Structures sort last so they are the first dropped: a report covers the
        # whole campaign, while a structure covers one target and is still on this
        # machine in boltz_cif/.
        order = sorted(
            members,
            key=lambda m: (m[0].startswith("structures/"), m[1].stat().st_size),
        )
        for arcname, path in order:
            size = path.stat().st_size
            if running + size > MAX_TOTAL_BYTES and arcname.startswith("structures/"):
                skipped.append({
                    "arcname": arcname, "kind": "structure",
                    "reason": f"dropped to stay under the {MAX_TOTAL_BYTES // 1024 // 1024}MB size limit",
                })
                continue
            kept.append((arcname, path))
            running += size
        members = kept
        warn(f"{sum(1 for s in skipped if 'size limit' in s['reason'])} structures dropped; "
             "they remain on this machine in boltz_cif/")

    manifest = {
        "bmz_version": BMZ_VERSION,
        "campaign_name": {{ campaign_name | tojson }},
        "created_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "prepared_utc": {{ created | tojson }},
        "prepared_by": {{ site_url | tojson }},
        # Both copied straight from the bundle. run_key ties this file back to the
        # bundle that produced it; private is the instruction the receiving site
        # honours without needing any record of its own.
        "run_key": {{ run_key | tojson }},
        # `| tojson` would render JSON's `false`, which is not Python -- and this
        # file is Python. Strings survive tojson unchanged (a JSON string is a valid
        # Python literal); booleans do not.
        "private": {{ 'True' if private else 'False' }},
        # No version string exists in BoltzMaker.py to record, so the script is
        # identified by its own content hash instead. It cannot drift from what
        # actually ran, and it is checkable against any given checkout.
        "boltzmaker_sha256": sha256_of(CAMPAIGN_DIR / "BoltzMaker.py")
                             if (CAMPAIGN_DIR / "BoltzMaker.py").is_file() else None,
        "platform": {"system": platform.system(), "machine": platform.machine(),
                     "python": platform.python_version()},
        "targets_in_summary": len(rows),
        "targets_expected": {{ target_count }},
        "structures_included": sum(1 for a, _ in members if a.startswith("structures/")),
        "images_included": sum(1 for a, _ in members if a.startswith("plip/")),
        "skipped": skipped,
        "files": {},
    }

    def add(zf, path, arcname):
        """zf.write(), but tolerant of a timestamp the zip format cannot store."""
        stamp = max(path.stat().st_mtime, ZIP_SAFE_EPOCH)
        entry = zipfile.ZipInfo(arcname, date_time=time.localtime(stamp)[:6])
        entry.compress_type = zipfile.ZIP_DEFLATED
        entry.external_attr = 0o644 << 16
        with path.open("rb") as src, zf.open(entry, "w") as dest:
            shutil.copyfileobj(src, dest)

    info(f"packing {len(members)} files for {len(rows)} targets")
    with zipfile.ZipFile(OUT_PATH, "w", zipfile.ZIP_DEFLATED, compresslevel=6) as zf:
        for arcname, path in members:
            add(zf, path, arcname)
            manifest["files"][arcname] = {
                "bytes": path.stat().st_size,
                "sha256": sha256_of(path),
            }
        # Written last so it can describe every other member, including hashes.
        zf.writestr("manifest.json", json.dumps(manifest, indent=2))

    size_mb = OUT_PATH.stat().st_size / 1024 / 1024
    ok(f"wrote {OUT_PATH.name} ({size_mb:.1f}MB)")
    if manifest["targets_in_summary"] < manifest["targets_expected"]:
        warn(f"{manifest['targets_expected'] - manifest['targets_in_summary']} of "
             f"{manifest['targets_expected']} targets are missing from the summary -- "
             "the campaign did not fully complete.")
    if skipped:
        warn(f"{len(skipped)} items were not packed (all recorded in manifest.json):")
        for item in skipped[:5]:
            print(f"    - {item['arcname']}: {item['reason']}")
        if len(skipped) > 5:
            print(f"    ... and {len(skipped) - 5} more")
    return 0


if __name__ == "__main__":
    sys.exit(main())
