#!/usr/bin/env bash
# {{ campaign_name }} -- generated by BoltzMaker on {{ created }}
#
# Runs the whole campaign: installs a pinned environment, generates the target
# YAMLs, preflights them, predicts with Boltz-2, analyses the results, and
# packs one .bmz file to upload back to {{ site_url }}/auto/analysis
#
# Safe to re-run. `run` is idempotent -- targets that already have a complete
# prediction are skipped, so an interrupted campaign resumes where it stopped.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

BLUE='\033[38;2;30;115;190m'
GREEN='\033[38;2;0;208;132m'
AMBER='\033[38;2;252;185;0m'
RED='\033[38;2;216;27;140m'
RESET='\033[0m'
BOLD='\033[1m'

info() { printf "${BLUE}i${RESET} %s\n" "$1"; }
ok()   { printf "${GREEN}v${RESET} %s\n" "$1"; }
step() { printf "\n${BLUE}->${RESET} ${BOLD}%s${RESET}\n" "$1"; }
warn() { printf "${AMBER}!${RESET} %s\n" "$1"; }
fail() { printf "${RED}x${RESET} %s\n" "$1" >&2; }

printf "\n${BOLD}${BLUE}   ___       ____      __  ___     __${RESET}\n"
printf "${BOLD}${BLUE}  / _ )___  / / /____ /  |/  /__ _/ /_____ ____${RESET}\n"
printf "${BOLD}${BLUE} / _  / _ \\/ / __/_ // /|_/ / _ \`/  '_/ -_) __/${RESET}\n"
printf "${BOLD}${BLUE}/____/\\___/_/\\__//__/_/  /_/\\_,_/_/\\_\\\\__/_/${RESET}\n\n"
info "campaign: {{ campaign_name }}"
info "targets:  {{ target_count }}"
info "prepared: {{ created }}"

case "$(uname -s)" in
    Darwin|Linux) ;;
    *) warn "unrecognised platform '$(uname -s)' -- BoltzMaker targets macOS (Apple Silicon) and Linux (x86-64/CUDA)." ;;
esac

# ---------------------------------------------------------------------------
# 1. Environment
# ---------------------------------------------------------------------------
# pixi solves pixi.toml/pixi.lock, which is the same lockfile BoltzMaker itself
# is tested against -- boltz, RDKit, and the PLIP/OpenBabel/PyMOL stack in one
# environment. The lock pins every package for both osx-arm64 and linux-64, so
# what installs here is what was tested, not whatever is newest today.
step "Environment"
if ! command -v pixi >/dev/null 2>&1; then
    export PATH="$HOME/.pixi/bin:$PATH"
fi
if ! command -v pixi >/dev/null 2>&1; then
    info "pixi not found -- installing it (https://pixi.sh)"
    curl -fsSL https://pixi.sh/install.sh | sh
    export PATH="$HOME/.pixi/bin:$PATH"
    if ! command -v pixi >/dev/null 2>&1; then
        fail "pixi installed but is not on PATH in this shell."
        info "Run:  source ~/.zshrc   (or open a new terminal), then re-run this script."
        exit 1
    fi
fi
ok "pixi $(pixi --version 2>/dev/null || echo present)"

info "solving and installing the environment (several GB on a first run, cached afterwards)"
pixi install
# plip/pdb-tools are installed separately rather than in the main solve -- see
# the comment on the postinstall task in pixi.toml for why.
pixi run postinstall
ok "environment ready"

# ---------------------------------------------------------------------------
# 2. The campaign
# ---------------------------------------------------------------------------
# Every flag below was chosen in the Prepare form and is written out literally
# rather than read from config.json at run time, so that this line is a thing
# you can read and check rather than a thing you have to trust. config.json
# travels alongside as machine-readable provenance and is copied into the
# results file.
#
# Boltz-2's model weights (several GB) download on first use and are cached in
# your home directory; they are deliberately not shipped in the bundle.
step "Running the campaign"
warn "this is the long part -- structure prediction is GPU work and scales with target size"

set +e
pixi run python3 BoltzMaker.py all boltz_input.md \
{%- for line in cli_lines %}
    {{ line }}{% if not loop.last %} \{% endif %}
{%- endfor %}
CAMPAIGN_STATUS=$?
set -e

if [ "$CAMPAIGN_STATUS" -ne 0 ]; then
    fail "the campaign exited with status $CAMPAIGN_STATUS"
    info "Anything that did finish is still on disk, and this script is resumable --"
    info "re-run it and completed targets are skipped rather than recomputed."
    info "Packing whatever completed so the results can still be inspected."
fi

# ---------------------------------------------------------------------------
# 3. Pack the results
# ---------------------------------------------------------------------------
# Packing runs even when the campaign failed part-way: a campaign where 12 of 15
# targets succeeded is worth looking at, and the manifest records the shortfall
# rather than hiding it.
step "Packing results"
pixi run python3 pack_results.py
ok "done"

echo
if [ "$CAMPAIGN_STATUS" -eq 0 ]; then
    ok "campaign complete."
else
    warn "campaign finished with errors (status $CAMPAIGN_STATUS) -- the results file holds what succeeded."
fi
info "Upload {{ results_filename }} at:"
printf "    ${BOLD}{{ site_url }}/auto/analysis${RESET}\n\n"
exit "$CAMPAIGN_STATUS"
