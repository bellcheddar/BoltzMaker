# One-shot cleanup of stale per-request scratch dirs. Backstop for the case a
# gunicorn worker got SIGKILL'd mid-request (skipping its own try/finally
# shutil.rmtree cleanup in boltzmaker_web/app.py's new_scratch_dir callers) -- not a
# substitute for that cleanup, just a safety net. Triggered by the paired .timer.
[Unit]
Description=Delete stale BoltzMaker web scratch dirs

[Service]
Type=oneshot
User=boltzmaker
# -mmin +15: only dirs older than 15 minutes -- generous headroom over the longest
# real request (analyze's own 300s subprocess timeout plus upload time), so this
# never races a genuinely in-flight request.
ExecStart=/usr/bin/find /opt/boltzmaker/web/scratch -mindepth 1 -maxdepth 1 -mmin +15 -exec rm -rf {} +
# Analysis sessions (Fully Automated Mode) are swept separately and far less
# aggressively. They deliberately live OUTSIDE scratch/ because they are not
# per-request temp dirs: the explorer serves a structure per target on demand, so
# a session has to survive as long as someone is reading it. +150 is the app's own
# 2-hour TTL (SESSION_TTL_SECONDS in views_auto.py) plus headroom, so this only
# ever removes sessions the app already considers expired -- the app sweeps them
# itself on each upload, and this is the backstop for a site that goes quiet.
ExecStart=/usr/bin/find /opt/boltzmaker/web/sessions -mindepth 1 -maxdepth 1 -mmin +150 -exec rm -rf {} +
